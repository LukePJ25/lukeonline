---
import { BUTTON_STYLING_SHARED } from '../consts.ts'
const { image, title, desc, link } = Astro.props

const buttonStyling = BUTTON_STYLING_SHARED + ' flex-col '
---

<a href={link} class={buttonStyling}>
  {
    image && (
      <img
        src={image.link}
        alt={image.alt}
        class="aspect-4/5 w-full object-cover"
      />
    )
  }
  {title && <span class="font-bold">{title}</span>}
  {desc && <span>{desc}</span>}
</a>
