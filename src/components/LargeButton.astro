---
const { image, title, desc, link } = Astro.props

const buttonStyling =
  'border-solid border-1 border-gray-300' +
  ' bg-gray-50 flex flex-col gap-1 p-2 hover:text-blue-500' +
  ' hover:underline focus:bg-blue-50 focus:rounded hover:bg-gray-200'
---

<a href={link} class={buttonStyling}>
  {
    image && (
      <img
        src={image.link}
        alt={image.alt}
        class="aspect-4/5 w-full object-cover"
      />
    )
  }
  {title && <span class="font-bold">{title}</span>}
  {desc && <span>{desc}</span>}
</a>
