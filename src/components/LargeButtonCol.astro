---
import LargeButton from "./LargeButton.astro";

const { ...props } = Astro.props;

const entries = props.entries;
---
<div class="grid gap-2 grid-cols-1">
  {entries.map(entry =>
      <LargeButton title={entry.title}
                   desc={entry.desc}
                   link={entry.link}
        />
  )}
</div>
