---
const { rows } = Astro.props
---

<table class="w-full table-auto">
  {
    Object.entries(rows).map(([param, value]) => (
      <tr class="w-full p-4 odd:bg-gray-100 even:bg-gray-50">
        <td class="p-2 pr-4 pl-4 italic">{param}</td>
        <td class="flex h-auto flex-row flex-wrap gap-2 p-2 pr-4 pl-4">
          {Array.isArray(value)
            ? value.map((item) => (
                <span class="p-1/2 rounded-sm bg-gray-600 pr-2 pl-2 text-white">
                  {item}
                </span>
              ))
            : (value ?? '-')}
        </td>
      </tr>
    ))
  }
</table>
