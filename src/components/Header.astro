---
import { BUTTON_STYLING_SHARED } from '../consts.ts'
const { title } = Astro.props

const linkStyling =
  BUTTON_STYLING_SHARED + ' h-8 p-1 pl-2 grow items-center gap-3'
---

<header class="flex flex-col gap-2">
  <nav class="flex flex-row flex-wrap justify-between gap-2">
    <a class={linkStyling} href="/">Home</a>
    <a class={linkStyling} href="/projects">Projects</a>
    <a class={linkStyling} href="/blog">Blog</a>
    <a class={linkStyling} href="/photos">Photos</a>
    <a class={linkStyling} href="/about">About</a>
  </nav>
</header>
