---
const { image, link } = Astro.props

const buttonStyling =
  'border-solid border-1 border-gray-300' +
  ' bg-gray-50 flex flex-row gap-1 p-2 hover:text-blue-500' +
  ' hover:underline focus:bg-blue-50 focus:rounded hover:bg-gray-200' +
  ' items-center gap-3'
---

<a href={link} class={buttonStyling}>
  <img src={image.link} alt={image.alt} class="h-8 w-8 object-cover" />
  <span>{image.alt}</span>
</a>
