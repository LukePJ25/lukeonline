---
import { BUTTON_STYLING_SHARED } from '../consts.ts'
const { image, link } = Astro.props

const buttonStyling = BUTTON_STYLING_SHARED + ' flex-row items-center gap-3'
---

<a href={link} class={buttonStyling}>
  <img src={image.link} alt={image.alt} class="h-8 w-8 object-cover" />
  <span>{image.alt}</span>
</a>
