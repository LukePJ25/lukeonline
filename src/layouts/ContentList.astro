---
import Base from "./Base.astro";

const { ...props } = Astro.props;

const postStyling = "flex flex-col bg-gray-100 " +
  "p-1 pl-3 pr-3 hover:bg-gray-300 "
---
<Base title={props.title}>
  <slot />
  <div class="flex flex-col gap-3">
    {props.content.map(post => (
      <a class={postStyling} href={post.link}>
        <span>{post.title}</span>
        <span class="text-sm font-light">{post.desc}</span>
      </a>
    ))}
  </div>
</Base>
