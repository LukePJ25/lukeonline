u---
import Base from "../layouts/Base.astro";
import Heading from "../components/Heading.astro";
import LargeButtonRow from "../components/LargeButtonRow.astro";
import IconButtonRow from "../components/IconButtonRow.astro";
import Webring from "../components/Webring.astro";

const title = "Home";

const mainButtonRow = [
  {
    "title": "Projects",
    "desc": "A list of a few of my projects",
    "link": "/projects"
  },
  {
    "title": "Blog",
    "desc": "A small blog for occasionally discussing what I'm working on",
    "link": "/blog"
  },
  {
    "title": "Photos",
    "desc": "A small gallery of photographs from my free time",
    "link": "/photos"
  }
];

const iconButtonRow = [
  {
    image: {
        link: "/src/assets/github.svg",
        alt: "GitHub"
    },
    link: "https://github.com/LukePJ25"
  },
  {
    image: {
        link: "/src/assets/linkedin.svg",
        alt: "Linkedin"
    },
    link: "https://www.linkedin.com/in/lukepjones/"
  }
];
---
<Base title={title}>
  <p>I'm Luke Jones. I'm studying Computer Science at Aberystwyth
     University. Right now I'm on my industrial year.</p>
  <div class="flex flex-col gap-2">
    <LargeButtonRow entries={mainButtonRow} />
    <div class="flex flex-row justify-between">
      <IconButtonRow entries={iconButtonRow} />
      <Webring />
    </div>
  </div>
</Base>
