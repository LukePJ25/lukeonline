---
import ContentList from "../../layouts/ContentList.astro";
import TextSection from "../../components/TextSection.astro";

import { getCollection, getEntry } from 'astro:content';

const title = "Blog";

const blogPosts = await getCollection('blog');

const contentData = blogPosts.map((post) => ({
  title: post.data.title,
  desc: `${post.data.desc} - ${post.data.date.toLocaleDateString()}`
}));

console.log('POSTS: ', blogPosts)
---
<ContentList title={title} content={contentData} />
